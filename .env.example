# OpenAI
OPENAI_API_KEY=sk-...
# порожньо -> api.openai.com; сумісний провайдер, напр. https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# PostgreSQL
DATABASE_URL=postgresql+psycopg://pbc:pbc@localhost:5432/pbc_chat

# App
APP_ENV=local
LOG_LEVEL=INFO
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_INPUT_TOKENS=8000
